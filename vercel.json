{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tv-core-making.vercel.app"
        }
      ],
      "destination": "https://coremaking.web.id/$1",
      "permanent": true
    }
  ]
}
